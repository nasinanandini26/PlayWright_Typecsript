node_modules/
dist/

# Generated per-run report folders (testreports/<feature>_<DDMMYYYYHHmm>/,
# each with its own html+json+screenshots) — folder itself kept via .gitkeep.
testreports/*
!testreports/.gitkeep

test-results/
playwright-report/

# Saved login session (storage.state.path, used by default for every
# scenario except @guest ones) — contains live session cookies, generated
# at runtime, never commit it.
.auth/
*.log
.DS_Store
.env
.claude/settings.local.json
node_modules/
